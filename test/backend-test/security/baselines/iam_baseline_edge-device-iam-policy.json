{
  "full": {
    "Statement": [
      {
        "Action": [
          "s3:GetObject",
          "s3:GetObjectVersion"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:s3:::dda-component-*/*",
          "arn:aws:s3:::greengrass-component-artifacts-*/*"
        ],
        "Sid": "GreengrassComponentDownload"
      },
      {
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents",
          "logs:DescribeLogStreams"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:logs:*:*:log-group:/aws/greengrass/*",
        "Sid": "CloudWatchLogsUpload"
      },
      {
        "Action": "sts:AssumeRole",
        "Effect": "Allow",
        "Resource": "arn:aws:iam::*:role/dda-cross-account-role",
        "Sid": "AssumeDataAccountRole"
      },
      {
        "Action": [
          "iot:Connect",
          "iot:Publish",
          "iot:Subscribe",
          "iot:Receive"
        ],
        "Effect": "Allow",
        "Resource": "*",
        "Sid": "IoTDataPlane"
      },
      {
        "Action": [
          "greengrass:GetDeploymentStatus",
          "greengrass:GetConnectivityInfo"
        ],
        "Effect": "Allow",
        "Resource": "*",
        "Sid": "GreengrassConnectivity"
      }
    ],
    "Version": "2012-10-17"
  },
