{
 "Description": "IAM role for DDA Portal to access UseCase Account resources (v2 - with device management)",
 "Resources": {
  "DDAGreengrassDevicePolicyC3487411": {
   "Type": "AWS::IAM::ManagedPolicy",
   "Properties": {
    "Description": "Allows Greengrass devices to download DDA component artifacts from Portal and UseCase S3 buckets, and pull Docker component images from ECR",
    "ManagedPolicyName": "DDAPortalComponentAccessPolicy",
    "Path": "/",
    "PolicyDocument": {
     "Statement": [
      {
       "Action": [
        "s3:GetObject",
        "s3:GetBucketLocation"
       ],
       "Effect": "Allow",
       "Resource": [
        "arn:aws:s3:::dda-component-us-east-1-111111111111",
        "arn:aws:s3:::dda-component-us-east-1-111111111111/*"
       ],
       "Sid": "AllowPortalComponentBucketAccess"
      },
      {
       "Action": [
        "s3:GetObject",
        "s3:GetBucketLocation",
        "s3:HeadObject"
       ],
       "Effect": "Allow",
       "Resource": [
        "arn:aws:s3:::dda-*",
        "arn:aws:s3:::dda-*/*",
        "arn:aws:s3:::*-dda-*",
        "arn:aws:s3:::*-dda-*/*"
       ],
       "Sid": "AllowDDABucketPatternAccess"
      },
      {
       "Action": [
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:GetObject",
        "s3:GetBucketLocation"
       ],
       "Effect": "Allow",
       "Resource": [
        "arn:aws:s3:::dda-inference-results-*",
        "arn:aws:s3:::dda-inference-results-*/*"
       ],
       "Sid": "AllowInferenceResultsUpload"
      },
      {
       "Action": "ecr:GetAuthorizationToken",
       "Effect": "Allow",
       "Resource": "*",
       "Sid": "AllowEcrAuthToken"
      },
      {
       "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
       ],
       "Effect": "Allow",
       "Resource": {
        "Fn::Join": [
         "",
         [
          "arn:aws:ecr:*:",
          {
           "Ref": "AWS::AccountId"
          },
          ":repository/dda/*"
         ]
        ]
       },
       "Sid": "AllowEcrImagePull"
      }
     ],
     "Version": "2012-10-17"
    }
   },
   "Metadata": {
    "aws:cdk:path": "DDAPortalUseCaseAccountStack/DDAGreengrassDevicePolicy/Resource"
   }
  },
