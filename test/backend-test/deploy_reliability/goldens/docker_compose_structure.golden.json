{
  "services": {
    "backend_generic": {
      "build": {
        "args": {
          "ONNXRUNTIME_GPU": "${ONNXRUNTIME_GPU:-0}",
          "ONNXRUNTIME_SPEC": "${ONNXRUNTIME_SPEC:-onnxruntime==1.16.3}",
          "OS": "${OS:-20.04}",
          "PLATFORM": "${PLATFORM:-x86_64}",
          "PYTHON_VERSION": "${PYTHON_VERSION:-3.11}"
        },
        "context": "./backend",
        "dockerfile": "${BACKEND_DOCKERFILE:-Dockerfile}"
      },
      "environment": [
        "DDA_SYSTEM_USER_ID=$DDA_SYSTEM_USER_ID",
        "DDA_SYSTEM_GROUP_ID=$DDA_SYSTEM_GROUP_ID",
        "DDA_ADMIN_USER_ID=$DDA_ADMIN_USER_ID",
        "DDA_ADMIN_GROUP_ID=$DDA_ADMIN_GROUP_ID",
        "AWS_REGION",
        "SVCUID",
        "AWS_GG_NUCLEUS_DOMAIN_SOCKET_FILEPATH_FOR_COMPONENT",
        "AWS_CONTAINER_AUTHORIZATION_TOKEN",
        "AWS_CONTAINER_CREDENTIALS_FULL_URI",
        "AWS_IOT_THING_NAME",
        "COMPONENT_WORK_PATH",
        "KERNEL_ROOT_PATH",
        "INFERENCE_COMPONENT_DECOMPRESED_PATH",
        "LOCAL_SERVER_COMPONENT_DECOMPRESSED_PATH",
        "JETSON_CUDA=$JETSON_CUDA",
        "JETSON_TENSORRT=$JETSON_TENSORRT",
        "LD_LIBRARY_PATH=$LD_LIBRARY_PATH",
        "GRPC_POLL_STRATEGY=poll",
        "GRPC_ENABLE_FORK_SUPPORT=1",
        "PYTHONPATH=/opt/tritonserver/backends/python:/"
      ],
      "expose": [
        "5000",
        "5443",
        "8000",
        "8001",
        "8002"
      ],
      "image": "flask-app",
      "network_mode": "host",
      "privileged": true,
      "profiles": [
        "generic"
      ],
      "volumes": [
        "/aws_dda:/aws_dda",
        "/tmp:/tmp",
        "/dev/shm:/dev/shm"
      ]
    },
    "backend_tegra_gpu_enabled": {
      "build": {
        "args": {
          "ONNXRUNTIME_GPU": "${ONNXRUNTIME_GPU:-0}",
          "ONNXRUNTIME_SPEC": "${ONNXRUNTIME_SPEC:-onnxruntime==1.16.3}",
          "OS": "${OS:-20.04}",
          "PLATFORM": "${PLATFORM:-aarch64}",
          "PYTHON_VERSION": "${PYTHON_VERSION:-3.11}"
        },
        "context": "./backend",
        "dockerfile": "${BACKEND_DOCKERFILE:-Dockerfile}"
      },
      "environment": [
        "OS=$OS",
        "DDA_SYSTEM_USER_ID=$DDA_SYSTEM_USER_ID",
        "DDA_SYSTEM_GROUP_ID=$DDA_SYSTEM_GROUP_ID",
        "DDA_ADMIN_USER_ID=$DDA_ADMIN_USER_ID",
        "DDA_ADMIN_GROUP_ID=$DDA_ADMIN_GROUP_ID",
        "AWS_REGION",
        "SVCUID",
        "AWS_GG_NUCLEUS_DOMAIN_SOCKET_FILEPATH_FOR_COMPONENT",
        "AWS_CONTAINER_AUTHORIZATION_TOKEN",
        "AWS_CONTAINER_CREDENTIALS_FULL_URI",
        "AWS_IOT_THING_NAME",
        "COMPONENT_WORK_PATH",
        "KERNEL_ROOT_PATH",
        "INFERENCE_COMPONENT_DECOMPRESED_PATH",
        "LOCAL_SERVER_COMPONENT_DECOMPRESSED_PATH",
        "JETSON_CUDA=$JETSON_CUDA",
        "JETSON_TENSORRT=$JETSON_TENSORRT",
        "NVIDIA_VISIBLE_DEVICES=all",
        "NVIDIA_DRIVER_CAPABILITIES=all",
        "CUDA_HOME=/usr/local/cuda/",
        "LD_LIBRARY_PATH=/usr/local/cuda-12.6/targets/aarch64-linux/lib/:$LD_LIBRARY_PATH:$CUDA_HOME/lib64/:/usr/lib/aarch64-linux-gnu/tegra:/usr/local/cuda/targets/aarch64-linux/lib/:/opt/dda/trt8-runtime/lib",
        "GRPC_POLL_STRATEGY=poll",
        "GRPC_ENABLE_FORK_SUPPORT=1",
        "PYTHONPATH=/opt/tritonserver/backends/python:/",
        "ARGUS_HEADLESS=1",
        "NVARGUS_ENABLE_HEADLESS=1"
      ],
      "expose": [
        "5000",
        "5443"
      ],
      "image": "flask-app",
      "network_mode": "host",
      "platform": "linux/arm64/v8",
      "privileged": true,
      "profiles": [
        "tegra"
      ],
      "runtime": "nvidia",
      "volumes": [
        "/aws_dda:/aws_dda",
        "/tmp:/tmp",
        "/dev/shm:/dev/shm",
        "/usr/local/cuda:/usr/local/cuda/",
        "/usr/lib/aarch64-linux-gnu/tegra:/usr/lib/aarch64-linux-gnu/tegra",
        "/tmp/.X11-unix:/tmp/.X11-unix:rw",
        "/var/run/dbus:/var/run/dbus:ro",
        "/dev:/dev"
      ]
    },
    "frontend": {
      "build": "./frontend",
      "image": "react-webapp",
      "ports": [
        "3000:80",
        "3443:443"
      ],
      "volumes": [
        "/aws_dda:/aws_dda"
      ]
    }
  },
  "version": "3.0"
}
