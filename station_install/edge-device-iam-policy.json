{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GreengrassComponentDownload",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::dda-component-*/*",
        "arn:aws:s3:::greengrass-component-artifacts-*/*"
      ]
    },
    {
      "Sid": "CloudWatchLogsUpload",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/greengrass/*"
    },
    {
      "Sid": "AssumeDataAccountRole",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/dda-cross-account-role"
    },
    {
      "Sid": "IoTConnect",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:*:*:client/dda-*"
    },
    {
      "Sid": "IoTPublish",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": "arn:aws:iot:*:*:topic/dda/*"
    },
    {
      "Sid": "IoTSubscribe",
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": "arn:aws:iot:*:*:topicfilter/dda/*"
    },
    {
      "Sid": "IoTReceive",
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": "arn:aws:iot:*:*:topic/dda/*"
    },
    {
      "Sid": "GreengrassConnectivity",
      "Effect": "Allow",
      "Action": [
        "greengrass:GetDeploymentStatus",
        "greengrass:GetConnectivityInfo"
      ],
      "Resource": "*"
    }
  ]
}
