  "dda-plugin-fetch": {
    "Properties": {
      "Artifacts": {
        "Type": "NO_ARTIFACTS",
      },
      "Cache": {
        "Type": "NO_CACHE",
      },
      "Description": "Clones a public plugin repository at a revision and syncs the tree to plugin-sources/",
      "EncryptionKey": "alias/aws/s3",
      "Environment": {
        "ComputeType": "BUILD_GENERAL1_SMALL",
        "EnvironmentVariables": [
          {
            "Name": "ARTIFACTS_BUCKET",
            "Type": "PLAINTEXT",
            "Value": {
              "Fn::ImportValue": "Deps:ExportsOutputRefArtifacts82DD59A14F4A635A",
            },
          },
          {
            "Name": "REPO_URL",
            "Type": "PLAINTEXT",
            "Value": "",
          },
          {
            "Name": "REVISION",
            "Type": "PLAINTEXT",
            "Value": "",
          },
          {
            "Name": "DEST_PREFIX",
            "Type": "PLAINTEXT",
            "Value": "",
          },
        ],
        "Image": "aws/codebuild/standard:7.0",
        "ImagePullCredentialsType": "CODEBUILD",
        "PrivilegedMode": false,
        "Type": "LINUX_CONTAINER",
      },
      "Name": "dda-plugin-fetch",
      "ServiceRole": {
        "Fn::GetAtt": [
          "PluginFetchRoleA5F8096D",
          "Arn",
        ],
      },
      "Source": {
        "BuildSpec": "{
  "version": "0.2",
  "phases": {
    "build": {
      "commands": [
        "test -n \\"$REPO_URL\\" && test -n \\"$DEST_PREFIX\\"",
        "git clone \\"$REPO_URL\\" /tmp/repo",
        "if [ -n \\"$REVISION\\" ]; then git -C /tmp/repo checkout \\"$REVISION\\"; fi",
        "rm -rf /tmp/repo/.git",
        "aws s3 sync /tmp/repo/ \\"s3://$ARTIFACTS_BUCKET/$DEST_PREFIX/\\""
      ]
    }
  }
}",
        "Type": "NO_SOURCE",
      },
      "TimeoutInMinutes": 10,
    },
    "Type": "AWS::CodeBuild::Project",
  },
}
`;
