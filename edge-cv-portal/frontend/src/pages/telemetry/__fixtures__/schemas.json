{
  "registry": {
    "version": 1,
    "kinds": {
      "summary": "dda.summary.v1",
      "event": "dda.event.v1",
      "live": "dda.live.v1"
    },
    "modelStates": [
      "NONE",
      "READY",
      "LOADING",
      "UNLOADING",
      "UNAVAILABLE",
      "UNKNOWN",
      "NOT_DEPLOYED",
      "INCOMPLETE"
    ],
    "modelStateOrder": [
      "NONE",
      "READY",
      "UNLOADING",
      "LOADING",
      "INCOMPLETE",
      "NOT_DEPLOYED",
      "UNKNOWN",
      "UNAVAILABLE"
    ]
  },
  "catalog": {
    "version": 1,
    "description": "The Measure_Catalog (workflow-telemetry-dashboards design \u00a74.1 'Measures emitted', \u00a78.1): every measure the fold derives from a Summary (source summary) or counts from Events (source event), with the path into the validated fields, the fold, a unit and a label. perKey measures fold per map key (the path carries one '*'). The catalog has a version; tests/test_telemetry_schemas.py fails when the content changes without a version bump.",
    "folds": [
      "sum",
      "max",
      "mean",
      "p50mean",
      "p95max",
      "worst",
      "last",
      "count"
    ],
    "measures": [
      {
        "id": "runs_completed",
        "source": "summary",
        "path": "runs.completed",
        "fold": "sum",
        "unit": "count",
        "label": "Runs completed",
        "perKey": false
      },
      {
        "id": "runs_failed",
        "source": "summary",
        "path": "runs.failed",
        "fold": "sum",
        "unit": "count",
        "label": "Runs failed",
        "perKey": false
      },
      {
        "id": "runs_dropped",
        "source": "summary",
        "path": "runs.dropped",
        "fold": "sum",
        "unit": "count",
        "label": "Runs dropped",
        "perKey": false
      },
      {
        "id": "latency_p50_ms",
        "source": "summary",
        "path": "latency.p50Ms",
        "fold": "p50mean",
        "weight": "latency.n",
        "unit": "ms",
        "label": "Latency p50 (approximate)",
        "perKey": false
      },
      {
        "id": "latency_p95_ms",
        "source": "summary",
        "path": "latency.p95Ms",
        "fold": "p95max",
        "unit": "ms",
        "label": "Latency p95",
        "perKey": false
      },
      {
        "id": "latency_max_ms",
        "source": "summary",
        "path": "latency.maxMs",
        "fold": "max",
        "unit": "ms",
        "label": "Latency max",
        "perKey": false
      },
      {
        "id": "detections_total",
        "source": "summary",
        "path": "detections.total",
        "fold": "sum",
        "unit": "count",
        "label": "Detections",
        "perKey": false
      },
      {
        "id": "runs_with_detections",
        "source": "summary",
        "path": "detections.runsWithDetections",
        "fold": "sum",
        "unit": "count",
        "label": "Runs with detections",
        "perKey": false
      },
      {
        "id": "detections_class_total",
        "source": "summary",
        "path": "detections.perClass.*.total",
        "fold": "sum",
        "unit": "count",
        "label": "Detections per class",
        "perKey": true
      },
      {
        "id": "detections_class_max",
        "source": "summary",
        "path": "detections.perClass.*.max",
        "fold": "max",
        "unit": "count",
        "label": "Most detections of a class in one run",
        "perKey": true
      },
      {
        "id": "anomalous",
        "source": "summary",
        "path": "outcomes.anomalous",
        "fold": "sum",
        "unit": "count",
        "label": "Anomalous runs",
        "perKey": false
      },
      {
        "id": "normal",
        "source": "summary",
        "path": "outcomes.normal",
        "fold": "sum",
        "unit": "count",
        "label": "Normal runs",
        "perKey": false
      },
      {
        "id": "people_seen_max",
        "source": "summary",
        "path": "people.seen",
        "fold": "max",
        "unit": "count",
        "label": "People seen (max per run)",
        "perKey": false
      },
      {
        "id": "model_state_worst",
        "source": "summary",
        "path": "model.state",
        "fold": "worst",
        "unit": "state",
        "label": "Model state (worst)",
        "perKey": false
      },
      {
        "id": "model_waits",
        "source": "summary",
        "path": "model.waits",
        "fold": "sum",
        "unit": "count",
        "label": "Model readiness waits",
        "perKey": false
      },
      {
        "id": "model_wait_ms",
        "source": "summary",
        "path": "model.waitedMs",
        "fold": "sum",
        "unit": "ms",
        "label": "Model readiness wait time",
        "perKey": false
      },
      {
        "id": "continuous_skipped_no_new_frame",
        "source": "summary",
        "path": "continuous.skippedNoNewFrame",
        "fold": "sum",
        "unit": "count",
        "label": "Continuous runs skipped (no new frame)",
        "perKey": false
      },
      {
        "id": "continuous_paused",
        "source": "summary",
        "path": "continuous.paused",
        "fold": "last",
        "unit": "bool",
        "label": "Continuous runner paused",
        "perKey": false
      },
      {
        "id": "continuous_fps",
        "source": "summary",
        "path": "continuous.effectiveFps",
        "fold": "mean",
        "unit": "fps",
        "label": "Continuous effective fps",
        "perKey": false
      },
      {
        "id": "ppe_people_seen_max",
        "source": "summary",
        "path": "ext.ppe.people.seen",
        "fold": "max",
        "unit": "count",
        "label": "PPE: people seen (max)",
        "perKey": false
      },
      {
        "id": "ppe_people_violating_max",
        "source": "summary",
        "path": "ext.ppe.people.violating",
        "fold": "max",
        "unit": "count",
        "label": "PPE: people violating (max)",
        "perKey": false
      },
      {
        "id": "ppe_people_compliant_max",
        "source": "summary",
        "path": "ext.ppe.people.compliant",
        "fold": "max",
        "unit": "count",
        "label": "PPE: people compliant (max)",
        "perKey": false
      },
      {
        "id": "ppe_violation_frames",
        "source": "summary",
        "path": "ext.ppe.violations.frames",
        "fold": "sum",
        "unit": "count",
        "label": "PPE: violation frames",
        "perKey": false
      },
      {
        "id": "ppe_reason_frames",
        "source": "summary",
        "path": "ext.ppe.violations.byReason.*.frames",
        "fold": "sum",
        "unit": "count",
        "label": "PPE: violation frames by reason",
        "perKey": true
      },
      {
        "id": "ppe_reason_objects",
        "source": "summary",
        "path": "ext.ppe.violations.byReason.*.objects",
        "fold": "sum",
        "unit": "count",
        "label": "PPE: violating objects by reason",
        "perKey": true
      },
      {
        "id": "ppe_clips_opened",
        "source": "summary",
        "path": "ext.ppe.clipsOpened",
        "fold": "sum",
        "unit": "count",
        "label": "PPE: clips opened",
        "perKey": false
      },
      {
        "id": "ppe_frames",
        "source": "summary",
        "path": "ext.ppe.frames",
        "fold": "sum",
        "unit": "count",
        "label": "PPE: frames analysed",
        "perKey": false
      },
      {
        "id": "telemetry_queue_drops",
        "source": "summary",
        "path": "telemetry.queueDrops",
        "fold": "sum",
        "unit": "count",
        "label": "Telemetry queue drops",
        "perKey": false
      },
      {
        "id": "telemetry_publish_failures",
        "source": "summary",
        "path": "telemetry.publishFailures",
        "fold": "sum",
        "unit": "count",
        "label": "Telemetry publish failures",
        "perKey": false
      },
      {
        "id": "telemetry_events_dropped",
        "source": "summary",
        "path": "telemetry.eventsDropped",
        "fold": "sum",
        "unit": "count",
        "label": "Telemetry events dropped",
        "perKey": false
      },
      {
        "id": "summaries",
        "source": "summary",
        "path": "",
        "fold": "count",
        "unit": "count",
        "label": "Summaries folded",
        "perKey": false,
        "derived": true
      },
      {
        "id": "gaps",
        "source": "summary",
        "path": "gaps",
        "fold": "sum",
        "unit": "count",
        "label": "Sequence gaps",
        "perKey": false,
        "derived": true
      },
      {
        "id": "events_violation_confirmed",
        "source": "event",
        "path": "events.violation_confirmed",
        "fold": "count",
        "unit": "count",
        "label": "Violation events",
        "perKey": false,
        "eventType": "violation_confirmed"
      },
      {
        "id": "events_clip_ready",
        "source": "event",
        "path": "events.clip_ready",
        "fold": "count",
        "unit": "count",
        "label": "Clips",
        "perKey": false,
        "eventType": "clip_ready"
      },
      {
        "id": "events_run_error",
        "source": "event",
        "path": "events.run_error",
        "fold": "count",
        "unit": "count",
        "label": "Run errors",
        "perKey": false,
        "eventType": "run_error"
      }
    ]
  },
  "templates": {
    "generic-detector": {
      "id": "generic-detector",
      "version": 1,
      "label": "Generic detector",
      "description": "Runs, latency, detections per class, people seen and the model state of a detector workflow.",
      "requires": {
        "blocks": [
          "runs",
          "detections"
        ],
        "extensions": []
      },
      "panels": [
        {
          "id": "runs",
          "title": "Runs per minute",
          "chart": "area",
          "measures": [
            "runs_completed",
            "runs_failed",
            "runs_dropped"
          ]
        },
        {
          "id": "latency",
          "title": "Latency",
          "chart": "line",
          "measures": [
            "latency_p50_ms",
            "latency_p95_ms"
          ]
        },
        {
          "id": "detections",
          "title": "Detections per class",
          "chart": "stacked-bar",
          "measures": [
            "detections_class_total"
          ]
        },
        {
          "id": "people",
          "title": "People seen",
          "chart": "line",
          "measures": [
            "people_seen_max"
          ]
        },
        {
          "id": "model-state",
          "title": "Model state",
          "chart": "stacked-bar-states",
          "measures": [
            "model_state_worst"
          ],
          "note": "one series per state; each bucket contributes 1 to the series of its model_state_worst; NONE is not drawn"
        },
        {
          "id": "model-waits",
          "title": "Model waits",
          "chart": "mixed-line-bar",
          "measures": [
            "model_waits",
            "model_wait_ms"
          ],
          "bars": [
            "model_waits"
          ],
          "lines": [
            "model_wait_ms"
          ]
        }
      ],
      "tiles": [
        "now",
        "health",
        "live"
      ]
    },
    "anomaly": {
      "id": "anomaly",
      "version": 1,
      "label": "Anomaly detection",
      "description": "Runs, the anomalous share, latency and the model state of an anomaly workflow.",
      "requires": {
        "blocks": [
          "runs",
          "outcomes"
        ],
        "extensions": []
      },
      "panels": [
        {
          "id": "runs",
          "title": "Runs per minute",
          "chart": "area",
          "measures": [
            "runs_completed",
            "runs_failed",
            "runs_dropped"
          ]
        },
        {
          "id": "anomalous-share",
          "title": "Anomalous share",
          "chart": "pie-and-line",
          "measures": [
            "anomalous",
            "normal"
          ]
        },
        {
          "id": "latency",
          "title": "Latency",
          "chart": "line",
          "measures": [
            "latency_p50_ms",
            "latency_p95_ms"
          ]
        },
        {
          "id": "model-state",
          "title": "Model state",
          "chart": "stacked-bar-states",
          "measures": [
            "model_state_worst"
          ],
          "note": "one series per state; each bucket contributes 1 to the series of its model_state_worst; NONE is not drawn"
        }
      ],
      "tiles": [
        "now",
        "health",
        "live"
      ]
    },
    "ppe-compliance": {
      "id": "ppe-compliance",
      "version": 1,
      "label": "PPE compliance",
      "description": "The generic detector panels plus violations by reason, compliant and violating people, clips per hour and violation events.",
      "requires": {
        "blocks": [
          "runs",
          "detections"
        ],
        "extensions": [
          "ppe"
        ]
      },
      "panels": [
        {
          "id": "runs",
          "title": "Runs per minute",
          "chart": "area",
          "measures": [
            "runs_completed",
            "runs_failed",
            "runs_dropped"
          ]
        },
        {
          "id": "latency",
          "title": "Latency",
          "chart": "line",
          "measures": [
            "latency_p50_ms",
            "latency_p95_ms"
          ]
        },
        {
          "id": "detections",
          "title": "Detections per class",
          "chart": "stacked-bar",
          "measures": [
            "detections_class_total"
          ]
        },
        {
          "id": "people",
          "title": "People seen",
          "chart": "line",
          "measures": [
            "people_seen_max"
          ]
        },
        {
          "id": "model-state",
          "title": "Model state",
          "chart": "stacked-bar-states",
          "measures": [
            "model_state_worst"
          ],
          "note": "one series per state; each bucket contributes 1 to the series of its model_state_worst; NONE is not drawn"
        },
        {
          "id": "model-waits",
          "title": "Model waits",
          "chart": "mixed-line-bar",
          "measures": [
            "model_waits",
            "model_wait_ms"
          ],
          "bars": [
            "model_waits"
          ],
          "lines": [
            "model_wait_ms"
          ]
        },
        {
          "id": "violations-by-reason",
          "title": "Violations by reason",
          "chart": "stacked-bar",
          "measures": [
            "ppe_reason_frames"
          ]
        },
        {
          "id": "people-compliance",
          "title": "People compliant and violating",
          "chart": "line",
          "measures": [
            "ppe_people_compliant_max",
            "ppe_people_violating_max"
          ]
        },
        {
          "id": "clips",
          "title": "Clips per hour",
          "chart": "bar",
          "measures": [
            "events_clip_ready"
          ]
        },
        {
          "id": "violation-events",
          "title": "Violation events",
          "chart": "bar",
          "measures": [
            "events_violation_confirmed"
          ]
        }
      ],
      "tiles": [
        "now",
        "health",
        "clips",
        "live"
      ]
    }
  },
  "telemetryNowPollSeconds": 5,
  "cadence": {
    "now": 5,
    "series": {
      "minute": 60,
      "hour": 300,
      "day": 900
    },
    "events": 15,
    "clips": 15,
    "liveFrame": 2,
    "liveLease": 20,
    "manualRefreshMin": 10
  },
  "caps": {
    "devicesPerDashboard": 20,
    "dashboardsPerUsecase": 100,
    "liveMaxLeases": 5,
    "liveMaxViewMinutes": 30,
    "clipRetentionDays": 90,
    "deviceLiveLimit": 8,
    "summaryIntervalRange": [
      5,
      60
    ],
    "idleHeartbeatRange": [
      30,
      300
    ]
  },
  "personClasses": [
    "person",
    "human"
  ]
}
