# dda-plugin-build:arm64_cpu - generic arm64 CPU plugin build image
# (linux/arm64, native ARM build on a CodeBuild ARM fleet).
#
# Ubuntu 22.04 + GStreamer 1.20 dev headers (the x86_64 image's base and
# packages, on arm64), matching the generic arm64 CPU LocalServer image
# (src/backend/Dockerfile, which build-custom.sh always builds on an Ubuntu
# 22.04 base for this target) that non-Jetson arm64 hosts such as AWS
# Graviton run as aws.edgeml.dda.LocalServer.arm64. No CUDA/TensorRT/
# DeepStream: the target has no NVIDIA GPU. Used by the CodeBuild project
# dda-plugin-build-arm64_cpu (node-designer-stack.ts); the buildspec runs
# /usr/local/bin/dda-plugin-build.
#
# Build (from edge-cv-portal/plugin-build-images/):
#   docker buildx build --platform linux/arm64 -f Dockerfile.arm64_cpu \
#     -t <repo-uri>:arm64_cpu .
FROM public.ecr.aws/ubuntu/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

# Toolchain + GStreamer development headers. The Plugin_Scaffold meson
# projects (workflow_core/scaffold.py) depend on gstreamer-1.0,
# gstreamer-app-1.0 (libgstreamer-plugins-base1.0-dev) and python3-embed
# (python3-dev). autotools covers imported repositories using configure.ac.
# Ubuntu 22.04's apt meson (0.61) satisfies the scaffold's
# `meson_version : '>= 0.60'`. No dda-gst-introspect: dda-plugin-build
# runs introspection for x86_64 builds only.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        meson \
        ninja-build \
        cmake \
        autoconf \
        automake \
        libtool \
        git \
        python3 \
        python3-dev \
        python3-pip \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev \
        libgstreamer-plugins-bad1.0-dev \
        ca-certificates \
        curl \
        unzip \
        xxd \
    && rm -rf /var/lib/apt/lists/*

# AWS CLI v2 (S3 staging/promotion + KMS signing in the entrypoint).
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" \
        -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscliv2.zip /tmp/aws

COPY dda-plugin-build /usr/local/bin/dda-plugin-build
RUN chmod +x /usr/local/bin/dda-plugin-build
