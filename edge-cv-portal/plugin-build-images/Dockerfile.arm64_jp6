# dda-plugin-build:arm64_jp6 - Jetson JetPack 6 plugin build image
# (linux/arm64, native ARM build on a CodeBuild ARM fleet).
#
# Based on NVIDIA's L4T JetPack r36.x container (JetPack 6, Ubuntu 22.04,
# GStreamer 1.20) which ships the CUDA/TensorRT/multimedia JetPack SDK
# headers for plugins linking the NVIDIA stack. Pullable without NGC auth.
FROM nvcr.io/nvidia/l4t-jetpack:r36.3.0
ENV DEBIAN_FRONTEND=noninteractive

# Ubuntu 22.04: apt meson (0.61) satisfies the scaffold's >= 0.60.
# python3-dev (3.10) provides the python3-embed pkg-config dependency.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        meson \
        ninja-build \
        autoconf \
        automake \
        libtool \
        git \
        python3 \
        python3-dev \
        python3-pip \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev \
        libgstreamer-plugins-bad1.0-dev \
        ca-certificates \
        curl \
        unzip \
        xxd \
    && rm -rf /var/lib/apt/lists/*

# AWS CLI v2 (S3 staging/promotion + KMS signing in the entrypoint).
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" \
        -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscliv2.zip /tmp/aws

COPY dda-plugin-build /usr/local/bin/dda-plugin-build
RUN chmod +x /usr/local/bin/dda-plugin-build
