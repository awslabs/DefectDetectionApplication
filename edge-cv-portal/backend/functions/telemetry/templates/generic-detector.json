{
  "id": "generic-detector",
  "version": 1,
  "label": "Generic detector",
  "description": "Runs, latency, detections per class, people seen and the model state of a detector workflow.",
  "requires": {
    "blocks": [
      "runs",
      "detections"
    ],
    "extensions": []
  },
  "panels": [
    {
      "id": "runs",
      "title": "Runs per minute",
      "chart": "area",
      "measures": [
        "runs_completed",
        "runs_failed",
        "runs_dropped"
      ]
    },
    {
      "id": "latency",
      "title": "Latency",
      "chart": "line",
      "measures": [
        "latency_p50_ms",
        "latency_p95_ms"
      ]
    },
    {
      "id": "detections",
      "title": "Detections per class",
      "chart": "stacked-bar",
      "measures": [
        "detections_class_total"
      ]
    },
    {
      "id": "people",
      "title": "People seen",
      "chart": "line",
      "measures": [
        "people_seen_max"
      ]
    },
    {
      "id": "model-state",
      "title": "Model state",
      "chart": "stacked-bar-states",
      "measures": [
        "model_state_worst"
      ],
      "note": "one series per state; each bucket contributes 1 to the series of its model_state_worst; NONE is not drawn"
    },
    {
      "id": "model-waits",
      "title": "Model waits",
      "chart": "mixed-line-bar",
      "measures": [
        "model_waits",
        "model_wait_ms"
      ],
      "bars": [
        "model_waits"
      ],
      "lines": [
        "model_wait_ms"
      ]
    }
  ],
  "tiles": [
    "now",
    "health",
    "live"
  ]
}
