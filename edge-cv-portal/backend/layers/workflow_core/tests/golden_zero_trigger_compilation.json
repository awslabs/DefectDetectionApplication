  "folder_capture": {
    "arm64_jp4": {
      "document": {
        "executorBindings": [],
        "pluginDependencies": [],
        "schemaVersion": 1,
        "segments": [
          {
            "elements": [
              {
                "args": {
                  "blocksize": -1,
                  "location": "/aws_dda/images/latest.jpg"
                },
                "factory": "filesrc",
                "nodeId": "src"
              },
              {
                "args": {},
                "factory": "emexifextract",
                "nodeId": "src"
              },
              {
                "args": {},
                "factory": "jpegparse",
                "nodeId": "src"
              },
              {
                "args": {
                  "idct-method": 2
                },
                "factory": "jpegdec",
                "nodeId": "src"
              },
              {
                "args": {},
                "factory": "videoconvert",
                "nodeId": "src"
              },
              {
                "args": {
                  "method": "automatic"
                },
                "factory": "videoflip",
                "nodeId": "src"
              },
              {
                "args": {
                  "idct-method": 2,
                  "quality": 100
                },
                "factory": "jpegenc",
                "nodeId": "sink"
              },
              {
                "args": {
                  "buffer-message-id": "file-target_/aws_dda/captures-jpg",
                  "interval": 0,
                  "meta": ""
                },
                "factory": "emlcapture",
                "nodeId": "sink"
              }
            ],
            "from": null,
            "linkTo": null,
            "name": "s0"
          }
        ],
        "targetArch": "arm64_jp4",
        "workflowId": "",
        "workflowVersion": ""
      },
      "status": "ok"
    },
