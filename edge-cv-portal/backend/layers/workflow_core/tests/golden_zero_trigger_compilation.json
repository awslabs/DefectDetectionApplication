  "icam_inference_mqtt": {
    "arm64_jp4": {
      "document": {
        "executorBindings": [
          {
            "binding": "mqtt_publish",
            "downstreamNodeIds": [],
            "nodeId": "publish",
            "parameters": {
              "aws_iot": false,
              "broker_host": null,
              "broker_port": 1883,
              "greengrass": true,
              "iot_ca_cert_path": null,
              "iot_client_cert_path": null,
              "iot_private_key_path": null,
              "iot_thing_name": null,
              "payload_template": "{inference_json}",
              "qos": 0,
              "topic": "factory/line1/inspection"
            },
            "upstreamNodeIds": [
              "infer"
            ]
          }
        ],
        "pluginDependencies": [
          "python:awsiotsdk"
        ],
        "schemaVersion": 1,
        "segments": [
          {
            "elements": [
              {
                "args": {
                  "device": "/dev/video0"
                },
                "factory": "v4l2src",
                "nodeId": "cam"
              },
              {
                "args": {},
                "factory": "videoconvert",
                "nodeId": "cam"
              },
              {
                "args": {
                  "caps": "video/x-raw,format=RGB"
                },
                "factory": "capsfilter",
                "nodeId": "infer"
              },
              {
                "args": {
                  "model": "widget-anomaly-v3",
                  "model-repo": "/aws_dda/dda_triton/triton_model_repo",
                  "server-path": "/opt/tritonserver"
                },
                "factory": "emltriton",
                "nodeId": "infer"
              }
            ],
            "from": null,
            "linkTo": null,
            "name": "s0"
          }
        ],
        "targetArch": "arm64_jp4",
        "workflowId": "",
        "workflowVersion": ""
      },
      "status": "ok"
    },
