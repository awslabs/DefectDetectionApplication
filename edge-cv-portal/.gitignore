# Temporary files
/tmp/
*.tmp

# Account configuration files (contain External IDs and Role ARNs)
*-account-config.txt
*-account-*-config.txt

# Non-redistributable binary artifacts — staged at build time, never committed.
# The test-sandbox image is built with these directories empty (see
# test-sandbox/README.md "Staging the DDA plugins"): the proprietary edgemlsdk /
# AWS Panorama runtime (libpanorama.*.so), the DDA GStreamer plugin .so set, and
# the copied system libraries under plugins/lib/. NVIDIA CUDA/Triton libraries
# are pulled from the NVIDIA Triton image at build time, never stored here.
test-sandbox/plugins/*
!test-sandbox/plugins/.gitkeep
test-sandbox/dda_triton_resources/*
!test-sandbox/dda_triton_resources/.gitkeep
